From 4cfd1f38c9406e2eedeeddb7101416599b63a485 Mon Sep 17 00:00:00 2001
From: Flax <flax@flax.local>
Subject: [PATCH] ARM: dts: aspeed: tiogapass: fix ADM1278 compatible and
 disable riser mux

The HSC at i2c7@0x45 is an ADM1278, not ADM1275.  The kernel driver
detects the mismatch and refuses to create hwmon entries.  Fix the
compatible string so the driver binds correctly.

The PCA9544 mux at i2c1@0x71 serves the X24 riser card which is not
installed.  Probing the absent mux generates ~40 cascading errors for
its child devices (INA230, TMP75, NVMe, etc.).  Mark the entire subtree
disabled to silence these errors.

Upstream-Status: Inappropriate [machine-specific configuration]
---
 arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-tiogapass.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-tiogapass.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-tiogapass.dts
index ccfed3784fc3..1723a16538e1 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-tiogapass.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-tiogapass.dts
@@ -212,6 +212,7 @@ &i2c1 {
 	status = "okay";
 	//X24 Riser
 	i2c-mux@71 {
+		status = "disabled";
 		compatible = "nxp,pca9544";
 		#address-cells = <1>;
 		#size-cells = <0>;
@@ -508,7 +509,7 @@ &i2c7 {
 	status = "okay";
 	//HSC, AirMax Conn A
 	adm1278@45 {
-		compatible = "adm1275";
+		compatible = "adi,adm1278";
 		reg = <0x45>;
 		shunt-resistor-micro-ohms = <250>;
 	};
--
2.34.1
