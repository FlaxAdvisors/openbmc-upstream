					lpc-snoop@0 {
						compatible = "aspeed,ast2500-lpc-snoop";
						reg = <0x00 0x80>;
						clocks = <0x02 0x08>;
						interrupts = <0x08>;
						status = "okay";
						snoop-ports = <0x80>;
					};

					lhc@20 {
						compatible = "aspeed,ast2500-lhc";
						reg = <0x20 0x24 0x48 0x08>;
						phandle = <0x0b>;
