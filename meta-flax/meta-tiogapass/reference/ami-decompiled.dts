	chosen {
		linux,initrd-end = <0x8ffff7a0>;
		linux,initrd-start = <0x8feee000>;
		stdout-path = "/ahb/apb/serial@1e784000";
		bootargs = "console=ttyS4,115200n8 root=/dev/ram rw mem.devmem=1";
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <0x22 0x00 0x22 0x01 0x22 0x02 0x22 0x03 0x22 0x04 0x22 0x05 0x22 0x06 0x22 0x07>;
	};
};
