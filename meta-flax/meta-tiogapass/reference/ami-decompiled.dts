/dts-v1/;

/memreserve/	0x000000008fee2000 0x0000000000009000;
/memreserve/	0x000000008feee000 0x00000000001117a0;
/ {
	model = "Facebook TiogaPass BMC";
	compatible = "facebook,tiogapass-bmc\0aspeed,ast2500";
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;

	aliases {
		i2c0 = "/ahb/apb/bus@1e78a000/i2c-bus@40";
		i2c1 = "/ahb/apb/bus@1e78a000/i2c-bus@80";
		i2c2 = "/ahb/apb/bus@1e78a000/i2c-bus@c0";
		i2c3 = "/ahb/apb/bus@1e78a000/i2c-bus@100";
		i2c4 = "/ahb/apb/bus@1e78a000/i2c-bus@140";
		i2c5 = "/ahb/apb/bus@1e78a000/i2c-bus@180";
		i2c6 = "/ahb/apb/bus@1e78a000/i2c-bus@1c0";
		i2c7 = "/ahb/apb/bus@1e78a000/i2c-bus@300";
		i2c8 = "/ahb/apb/bus@1e78a000/i2c-bus@340";
		i2c9 = "/ahb/apb/bus@1e78a000/i2c-bus@380";
		i2c10 = "/ahb/apb/bus@1e78a000/i2c-bus@3c0";
		i2c11 = "/ahb/apb/bus@1e78a000/i2c-bus@400";
		i2c12 = "/ahb/apb/bus@1e78a000/i2c-bus@440";
		i2c13 = "/ahb/apb/bus@1e78a000/i2c-bus@480";
		serial0 = "/ahb/apb/serial@1e783000";
		serial1 = "/ahb/apb/serial@1e78d000";
		serial2 = "/ahb/apb/serial@1e78e000";
		serial3 = "/ahb/apb/serial@1e78f000";
		serial4 = "/ahb/apb/serial@1e784000";
		serial5 = "/ahb/apb/serial@1e787000";
		i2c16 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@0";
		i2c17 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@1";
		i2c18 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@2";
		i2c19 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@3";
		i2c20 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@0/i2c-switch@73/i2c@0";
		i2c21 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@0/i2c-switch@73/i2c@1";
		i2c22 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@0/i2c-switch@73/i2c@2";
		i2c23 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@0/i2c-switch@73/i2c@3";
		i2c24 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@1/i2c-switch@73/i2c@0";
		i2c25 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@1/i2c-switch@73/i2c@1";
		i2c26 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@1/i2c-switch@73/i2c@2";
		i2c27 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@1/i2c-switch@73/i2c@3";
		i2c28 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@2/i2c-switch@73/i2c@0";
		i2c29 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@2/i2c-switch@73/i2c@1";
		i2c30 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@2/i2c-switch@73/i2c@2";
		i2c31 = "/ahb/apb/bus@1e78a000/i2c-bus@80/i2c-switch@71/i2c@2/i2c-switch@73/i2c@3";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,arm1176jzf-s";
			device_type = "cpu";
			reg = <0x00>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1f800000>;
	};

	sdram@1e6e0000 {
		compatible = "aspeed,ast2500-sdram-edac\0syscon";
		reg = <0x1e6e0000 0x174>;
		interrupts = <0x00>;
		status = "disabled";
		phandle = <0x0d>;
	};

	ahb {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		spi@1e620000 {
			reg = <0x1e620000 0xc4 0x20000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-fmc";
			clocks = <0x02 0x19>;
			status = "okay";
			interrupts = <0x13>;

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "okay";
				label = "bmc";
				m25p,fast-read;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					u-boot@0 {
						reg = <0x00 0x80000>;
						label = "u-boot";
					};

					u-boot-env@80000 {
						reg = <0x80000 0x20000>;
						label = "u-boot-env";
					};

					kernel@a0000 {
						reg = <0xa0000 0x550000>;
						label = "kernel";
					};

					rofs@5f0000 {
						reg = <0x5f0000 0x1840000>;
						label = "rofs";
					};

					rwfs@1e30000 {
						reg = <0x1e30000 0x1d0000>;
						label = "rwfs";
					};
				};
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@2 {
				reg = <0x02>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};
		};

		spi@1e630000 {
			reg = <0x1e630000 0xc4 0x30000000 0x8000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-spi";
			clocks = <0x02 0x19>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x03>;

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "okay";
				m25p,fast-read;
				label = "pnor";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};
		};

		spi@1e631000 {
			reg = <0x1e631000 0xc4 0x38000000 0x8000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-spi";
			clocks = <0x02 0x19>;
			status = "disabled";

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x2faf080>;
				status = "disabled";
			};
		};

		interrupt-controller@1e6c0080 {
			compatible = "aspeed,ast2500-vic";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			valid-sources = <0xfefff7ff 0x807ffff>;
			reg = <0x1e6c0080 0x80>;
			phandle = <0x01>;
		};

		copro-interrupt-controller@1e6c2000 {
			compatible = "aspeed,ast2500-cvic\0aspeed-cvic";
			valid-sources = <0xffffffff>;
			copro-sw-interrupts = <0x01>;
			reg = <0x1e6c2000 0x80>;
		};

		ethernet@1e680000 {
			compatible = "aspeed,ast2500-mac\0faraday,ftgmac100";
			reg = <0x1e680000 0x180>;
			interrupts = <0x03>;
			clocks = <0x02 0x12 0x02 0x25>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x04>;
			clock-names = "MACCLK\0RCLK";
			use-ncsi;
		};

		ethernet@1e660000 {
			compatible = "aspeed,ast2500-mac\0faraday,ftgmac100";
			reg = <0x1e660000 0x180>;
			interrupts = <0x02>;
			clocks = <0x02 0x11 0x02 0x24>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x05>;
			clock-names = "MACCLK\0RCLK";
			use-ncsi;
		};

		usb@1e6a1000 {
			compatible = "aspeed,ast2500-ehci\0generic-ehci";
			reg = <0x1e6a1000 0x100>;
			interrupts = <0x05>;
			clocks = <0x02 0x0c>;
			pinctrl-names = "default";
			pinctrl-0 = <0x06>;
			status = "disabled";
		};

		usb@1e6a3000 {
			compatible = "aspeed,ast2500-ehci\0generic-ehci";
			reg = <0x1e6a3000 0x100>;
			interrupts = <0x0d>;
			clocks = <0x02 0x07>;
			pinctrl-names = "default";
			pinctrl-0 = <0x07>;
			status = "disabled";
		};

		usb@1e6b0000 {
			compatible = "aspeed,ast2500-uhci\0generic-uhci";
			reg = <0x1e6b0000 0x100>;
			interrupts = <0x0e>;
			#ports = <0x02>;
			clocks = <0x02 0x09>;
			status = "disabled";
		};

		usb-vhub@1e6a0000 {
			compatible = "aspeed,ast2500-usb-vhub";
			reg = <0x1e6a0000 0x300>;
			interrupts = <0x05>;
			clocks = <0x02 0x0c>;
			pinctrl-names = "default";
			pinctrl-0 = <0x08>;
			status = "okay";
		};

		videocap@0x1e700000 {
			compatible = "aspeed,aspeed-videocap";
			reg = <0x1e700000 0x1000>;
			interrupts = <0x07>;
			status = "ok";
		};

		usbhub@1e6a0000 {
			compatible = "aspeed,aspeed-usbhub";
			reg = <0x1e6a0000 0x1000>;
			interrupts = <0x05>;
			status = "ok";
		};

		espi@1e6ee000 {
			compatible = "aspeed,ast2500-espi-slave";
			reg = <0x1e6ee000 0x100>;
			interrupts = <0x17>;
			clocks = <0x02 0x10>;
			pinctrl-names = "default";
			pinctrl-0 = <0x09>;
			status = "disabled";
		};

		astpeci@0x1e78b000 {
			compatible = "aspeed,aspeed-peci";
			reg = <0x1e78b000 0x60>;
			interrupts = <0x0f>;
			status = "okay";
		};

		mctppcie@1e6e8000 {
			compatible = "aspeed,aspeed-mctppcie";
			reg = <0x1e6e8000 0x1000>;
			interrupts = <0x2a>;
			status = "disabled";
		};

		astscu@1e6e2000 {
			compatible = "aspeed,aspeed-astscu";
			reg = <0x1e6e2000 0x1000>;
			interrupts = <0x15>;
			status = "disabled";
		};

		apb {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			syscon@1e6e2000 {
				compatible = "aspeed,ast2500-scu\0syscon\0simple-mfd";
				reg = <0x1e6e2000 0x1a8>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x02>;

				interrupt-controller@18 {
					#interrupt-cells = <0x01>;
					compatible = "aspeed,ast2500-scu-ic";
					interrupts = <0x15>;
					interrupt-controller;
					phandle = <0x0c>;
				};

				pinctrl {
					compatible = "aspeed,ast2500-pinctrl";
					aspeed,external-nodes = <0x0a 0x0b>;
					phandle = <0x0e>;

					acpi_default {
						function = "ACPI";
						groups = "ACPI";
					};

					adc0_default {
						function = "ADC0";
						groups = "ADC0";
					};

